NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Optional PostgreSQL connection. Configure only in the deployment secret store.
DATABASE_URL=
DATABASE_SSL=false

# Authentication is intentionally disabled until a secure provider is configured.
AUTH_ENABLED=false
SESSION_SECRET=
SESSION_COOKIE_NAME=medorbit_session
SESSION_SECURE_COOKIE=true

# Set a strong random value only if you later implement a protected admin API.
ADMIN_TOKEN=

# Optional external service settings. Never commit real credentials.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
AI_API_URL=
AI_API_KEY=
AI_MODEL=
