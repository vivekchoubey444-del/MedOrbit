:root {
  --mo-navy: #07142e;
  --mo-blue: #102b60;
  --mo-sapphire: #1647a5;
  --mo-bright: #3979ed;
  --mo-gold: #d7b56d;
  --mo-cream: #f5f0e5;
  --mo-ink: #172442;
  --mo-muted: #66738e;
  --mo-panel: #ffffff;
  --mo-border: rgba(35, 72, 135, .16);
  --mo-shadow: 0 18px 50px rgba(7, 20, 46, .12);
  --mo-radius: 20px;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  color: var(--mo-ink);
  background: linear-gradient(135deg, #edf2fc, #f5f0e5 55%, #e8efff);
  font-family: Inter, "Segoe UI", Arial, sans-serif;
  line-height: 1.65;
  animation: mo-page-in .65s ease both;
}
@keyframes mo-page-in {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes mo-rise {
  from { opacity: 0; transform: translateY(18px); }
  to { opacity: 1; transform: translateY(0); }
}
a { color: var(--mo-sapphire); }
img, video, iframe { max-width: 100%; }
button, input, select, textarea { font: inherit; }
button, .mo-button, a.mo-button {
  display: inline-flex; align-items: center; justify-content: center;
  gap: 8px; padding: 11px 17px; border: 0; border-radius: 12px;
  background: linear-gradient(135deg, var(--mo-sapphire), var(--mo-blue));
  color: white; text-decoration: none; cursor: pointer;
  transition: transform .2s, box-shadow .2s, filter .2s;
}
button:hover, .mo-button:hover, a.mo-button:hover {
  transform: translateY(-2px); box-shadow: 0 10px 24px #1647a533;
}
input, select, textarea {
  width: 100%; min-width: 0; padding: 12px 14px;
  border: 1px solid var(--mo-border); border-radius: 12px;
  background: #fffdf9; color: var(--mo-ink);
}
input:focus, select:focus, textarea:focus {
  outline: 2px solid #3979ed55; border-color: var(--mo-bright);
}
label { display: block; font-weight: 650; margin: 12px 0 6px; }
h1, h2, h3 { color: var(--mo-navy); line-height: 1.2; }
h1 { letter-spacing: -.035em; }
.mo-site-header {
  position: sticky; top: 0; z-index: 1000;
  display: flex; align-items: center; justify-content: space-between;
  gap: 20px; padding: 14px clamp(16px, 4vw, 54px);
  color: white; background: linear-gradient(110deg, #07142e, #102b60 65%, #1647a5);
  border-bottom: 1px solid #d7b56d66; box-shadow: 0 8px 28px #07142e22;
}
.mo-brand { color: white; font-weight: 850; letter-spacing: .06em; text-decoration: none; }
.mo-brand span { color: var(--mo-gold); }
.mo-nav { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
.mo-nav a { color: #f5f0e5; text-decoration: none; font-size: .94rem; }
.mo-nav a:hover { color: var(--mo-gold); }
.mo-site-footer {
  margin-top: 50px; padding: 30px clamp(16px, 4vw, 54px);
  color: #e9efff; background: var(--mo-navy);
  border-top: 2px solid var(--mo-gold);
}
.mo-site-footer a { color: #e9efff; }
.mo-container { width: min(1200px, calc(100% - 32px)); margin-inline: auto; }
.mo-hero {
  padding: clamp(30px, 6vw, 76px); border-radius: 26px;
  color: white; background: radial-gradient(circle at 90% 10%, #3979ed66, transparent 34%),
  linear-gradient(125deg, #07142e, #102b60 62%, #1647a5);
  box-shadow: var(--mo-shadow); overflow: hidden;
}
.mo-hero h1, .mo-hero h2, .mo-hero p { color: white; }
.mo-hero h1 { font-size: clamp(2rem, 5vw, 4rem); }
.mo-gold { color: var(--mo-gold); }
.mo-section { padding-block: clamp(24px, 4vw, 48px); }
.mo-catalog {
  display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px; align-items: stretch;
}
.mo-card {
  min-width: 0; padding: clamp(16px, 2.5vw, 28px);
  border: 1px solid var(--mo-border); border-radius: var(--mo-radius);
  background: linear-gradient(145deg, #fffdf9, #eaf0fc);
  box-shadow: var(--mo-shadow); animation: mo-rise .55s ease both;
  transition: transform .22s, border-color .22s;
}
.mo-card:hover { transform: translateY(-5px); border-color: #3979ed88; }
.mo-card:nth-child(2) { animation-delay: .06s; }
.mo-card:nth-child(3) { animation-delay: .12s; }
.mo-card:nth-child(4) { animation-delay: .18s; }
.mo-card h2, .mo-card h3 { margin-top: 0; }
.mo-card p { color: var(--mo-muted); }
.mo-card-icon {
  display: grid; place-items: center; width: 48px; height: 48px;
  border-radius: 14px; margin-bottom: 14px; color: var(--mo-gold);
  background: linear-gradient(135deg, var(--mo-navy), var(--mo-sapphire));
  font-size: 1.3rem;
}
.mo-form-card { max-width: 650px; margin: 30px auto; }
.mo-status { padding: 12px 14px; margin-top: 14px; border-radius: 12px; }
.mo-status:empty { display: none; }
.mo-status[data-state="error"] { background: #ffebeb; color: #8d1c28; }
.mo-status[data-state="success"] { background: #e5f7ed; color: #145d37; }
.mo-search { display: flex; flex-wrap: wrap; gap: 10px; }
.mo-search input { flex: 1 1 240px; }
.mo-results { display: grid; gap: 12px; margin-top: 16px; }
.mo-result { padding: 15px; border: 1px solid var(--mo-border); border-radius: 14px; background: white; }
.mo-result a { font-weight: 750; }
.mo-file-drop {
  display: block; padding: 28px; border: 2px dashed #3979ed88;
  border-radius: 18px; background: #edf3ff; text-align: center;
}
.mo-small { font-size: .9rem; color: var(--mo-muted); }
@media (max-width: 680px) {
  .mo-site-header { align-items: flex-start; flex-direction: column; }
  .mo-nav { gap: 10px 14px; }
  .mo-catalog { grid-template-columns: minmax(0, 1fr); }
  .mo-hero { border-radius: 18px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important; animation-iteration-count: 1 !important;
    scroll-behavior: auto !important; transition-duration: .01ms !important;
  }
}
